# =============================
# ROG BACKEND - ENVIRONMENT EXAMPLE
# =============================

# Porta locale API / servizi Express
PORT=3000

# URL base usato dall'area personale per generare link
BASE_URL=https://revolutionofgiving.com

# -----------------------------
# Blockchain / Polygon
# -----------------------------

# Endpoint RPC Polygon mainnet (Alchemy, Infura, o altro provider)
# Consigliato: usare un provider con API key per evitare rate limit.
# Esempio Alchemy:
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/LA_TUA_API_KEY
#
# In alternativa puoi fornire una lista (fallback) separata da virgola:
# POLYGON_RPC_URLS=https://polygon-mainnet.g.alchemy.com/v2/KEY,https://rpc.ankr.com/polygon
POLYGON_RPC_URL=https://polygon-rpc.com/

# Indirizzo contratto ROGDao su Polygon mainnet
ROG_CONTRACT_ADDRESS=0x0723a5d24afCe5732c9D5C00Ae580934d5664Aa0

# Wallet ROG Cassa (destinazione donazioni USDC)
ROG_WALLET_ADDRESS=0xd5bcc7acc9d6862c784807134c1f70c3e7f9f790

# USDC (Circle) su Polygon mainnet
USDC_CONTRACT_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# Listener USDC incoming transfers (se il frontend invia USDC direttamente al wallet)
USDC_INCOMING_LISTENER_ENABLED=true
# Catch-up a partire da:
# - USDC_LISTENER_START_BLOCK (se impostato: forza rescan anche se esiste lo state file)
# - altrimenti dal lastProcessedBlock salvato nello state file
# - altrimenti ultimi USDC_LISTENER_DEFAULT_LOOKBACK_BLOCKS blocchi
#USDC_LISTENER_START_BLOCK=0
USDC_LISTENER_DEFAULT_LOOKBACK_BLOCKS=20000
# Per RPC pubblici conviene stare bassi (es. 200) per evitare "Block range is too large"
USDC_LISTENER_QUERY_CHUNK=200
USDC_LISTENER_MIN_QUERY_CHUNK=50

# Chiave del wallet backend che ha il ruolo BACKEND_ROLE nel contratto ROGDao
# Può essere:
#  - una private key esadecimale (es: 0xabc123...)
#  - OPPURE una mnemonic phrase (12/24 parole) se l'hai salvata così
# ATTENZIONE: NON committare mai questo file con la chiave reale.
BACKEND_PRIVATE_KEY=

# -----------------------------
# PostgreSQL (Coolify)
# -----------------------------

# Coolify di solito fornisce DATABASE_URL automaticamente.
# In locale puoi usare una istanza Postgres tua oppure lasciare vuoto.
# DATABASE_URL=postgres://user:password@host:5432/rog_db

# Tuning pool (utile se vedi "Connection terminated unexpectedly")
PGPOOL_MAX=5
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=10000
PGPOOL_KEEPALIVE_DELAY_MS=10000
PG_QUERY_RETRIES=2

# -----------------------------
# Donation Queue Worker (SCALABILITÀ)
# -----------------------------

# Abilita/disabilita worker coda donazioni
# Il worker processa donazioni asincrone per scalabilità 600+ donazioni/min
DONATION_WORKER_ENABLED=true

# Intervallo polling coda (ms)
# 500ms = 0.5 secondi = 120 batch/min per throughput massimo
DONATION_WORKER_INTERVAL_MS=500

# Concorrenza: numero donazioni processate in parallelo
# 20 = 20 donazioni simultanee per Coolify Professional
DONATION_WORKER_CONCURRENCY=20

# Batch size: donazioni estratte dalla coda per batch
# 10 donazioni/batch * 120 batch/min = 1200 donazioni/min
DONATION_WORKER_BATCH_SIZE=10

# Intervallo statistiche (ms) - Stats ogni 60 secondi
DONATION_WORKER_STATS_INTERVAL_MS=60000

# Forza SSL mode se serve:
# DATABASE_SSL=require|disable
# PGSSLMODE=require|disable

# -----------------------------
# Email alerts (web3-monitor)
# -----------------------------

EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=admin@rog.com

# -----------------------------
# Web3 monitor RPC (ETH mainnet) - opzionale
# -----------------------------

WEB3_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
ETHERSCAN_API_KEY=
