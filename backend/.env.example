# ============================================================
# URANUS BACKEND — Variabili d'ambiente (TEMPLATE)
# ============================================================
# Copiare questi valori nel pannello "Environment" di Coolify.
# NON committare il file .env reale coi segreti.
#
# Le variabili marcate [OBBLIGATORIA] sono verificate all'avvio
# (security-manager.validateEnvironment): se NODE_ENV=production e
# ne manca anche una sola, il backend NON si avvia.
# ============================================================

# ── Runtime ──
NODE_ENV=production
PORT=4000

# ── Database PostgreSQL ──
# [OBBLIGATORIA] stringa di connessione completa
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Blockchain / Polygon ──
# [OBBLIGATORIA] endpoint RPC Polygon. Consigliato Alchemy: serve anche
# per il check ROG "donation-since" on-chain (metodo alchemy_getAssetTransfers).
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/LA_TUA_API_KEY
# [OBBLIGATORIA] USDC NATIVO su Polygon (0x3c49…) — token realmente detenuto/usato dalla Cassa
# URANUS 0x4f53… (verificato on-chain 02/07/2026). DEVE coincidere con NEXT_PUBLIC_USDC_CONTRACT
# del frontend, altrimenti le donazioni NON vengono riconosciute e i payout falliscono.
USDC_CONTRACT_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# Tether Gold (XAUt0) su Polygon
XAUT0_CONTRACT_ADDRESS=0xF1815bd50389c46847f0Bda824eC8da914045D14
# Prezzo oro (USD/oz) per la conversione XAUt0 -> numero posizioni
GOLD_PRICE_USD=4000

# ── Wallet di sistema ──
# [OBBLIGATORIA] CASSA URANUS = tesoreria on-chain: riceve le donazioni, è assegnata a TUTTE le
# posizioni gemelle (CASSA) e da cui partono i payout. UNICO riferimento canonico (0x4f53…).
URANUS_CASSA_WALLET=0x4f53c4277E2e738CDb71375253b3fE30BBca95ce
# (LEGACY, opzionali) Vecchi nomi della STESSA cassa Uranus: usati solo come fallback se
# URANUS_CASSA_WALLET manca. Tenere uguali; rimovibili una volta impostato URANUS_CASSA_WALLET.
URANO_FUND_WALLET=0x4f53c4277E2e738CDb71375253b3fE30BBca95ce
CASSA_WALLET=0x4f53c4277E2e738CDb71375253b3fE30BBca95ce
# [OBBLIGATORIA] Wallet "0" di sistema. NON modificare senza analisi (vedi HANDOFF).
ACCOUNT_0_WALLET=0x0000000000000000000000000000000000000001
# [OBBLIGATORIA] Cassa ROG = destinatario donazioni ROG Small (DIVERSA dalla cassa Uranus!)
CASSA_ROG_WALLET=0xD5bCC7acc9d6862c784807134c1F70c3e7f9F790
# Alias usato dal checker ROG on-chain (tenere uguale a CASSA_ROG_WALLET)
ROG_WALLET_CASSA=0xD5bCC7acc9d6862c784807134c1F70c3e7f9F790
# Posizione 0 / Fondo "A" (apre i turni) = wallet FORTUNATO.
# NB: HARDCODED nel codice (legge committente) — questa riga è solo documentale, NON sovrascrivibile via env.
FONDO_WALLET=0x49b21573D1AEA396cDb6d2B9D8c8bD5bb25645a4

# ── Integrazione ROG (gate iscrizione + donazione) ──
# URL del backend ROG (SENZA slash finale). Necessario per il gate HUMAN.
ROG_BACKEND_URL=https://IL-TUO-BACKEND-ROG
# Chiave interna server-to-server: METTERE LO STESSO VALORE del
# ROG_INTERNAL_API_KEY configurato sul backend ROG. Senza, gli endpoint
# protetti /api/community/status e /api/donation-since rispondono 401/503
# e ogni utente HUMAN resta bloccato.
ROG_INTERNAL_API_KEY=STESSA_CHIAVE_INTERNA_DI_ROG
# Data minima della donazione ROG valida per il gate URANUS ("dopo la 20488")
ROG_DONATION_SINCE=2026-06-08
# (opzionale) blocco Polygon di riferimento per lo scan on-chain (hex). 0x0 = scan completo
ROG_BLOCK_8_GIUGNO=0x0
# (opzionale) Token USDC del check ON-CHAIN delle donazioni ROG. DISACCOPPIATO da USDC_CONTRACT_ADDRESS
# di URANUS. Default = USDC NATIVO 0x3c499c… (token reale della cassa ROG, verificato on-chain 02/07/2026).
# Impostare SOLO se ROG dovesse cambiare token.
ROG_USDC_CONTRACT_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# ── Sicurezza / CORS / Admin ──
# [OBBLIGATORIA] origine del frontend (NIENTE '*' in produzione).
# Più origini separate da virgola. Es: https://uranus.tuodominio,https://gateway.pinata.cloud
CORS_ORIGIN=https://IL-TUO-FRONTEND
# [OBBLIGATORIA] chiave admin per gli endpoint protetti (header X-Admin-Key)
ADMIN_API_KEY=GENERA_UNA_CHIAVE_LUNGA_RANDOM
# Credenziali pannello admin (se usate dal frontend admin)
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=METTI_UNA_PASSWORD_FORTE

# ── Segreti per payout / on-chain (necessari per distribuire i doni) ──
# Chiave privata della tesoreria che INVIA gli USDC dei payout. SEGRETISSIMA.
TREASURY_PRIVATE_KEY=
# Registro on-chain UranusRegistry (se attivo) + chiave backend con BACKEND_ROLE.
# Se lasciati vuoti, la registrazione on-chain è semplicemente disabilitata.
URANUS_REGISTRY_ADDRESS=
URANUS_BACKEND_PRIVATE_KEY=
# Segreto condiviso per le API cross-platform (/api/cross/*)
CROSS_PLATFORM_SECRET=

# ── Alert (opzionali, lasciare vuoti se non usati) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
JONNY_WHATSAPP=

# ── Tuning coda donazioni (opzionali, i default vanno bene) ──
ALTERNANZA_SOLIDALE=true
ALTERNANZA_GRACE_MS=300000
DONA_TX_MAX_ATTEMPTS=60
DONA_TX_RETRY_MS=3000

# ── Altri (opzionali / futuri) ──
PHARAOH_BACKEND_URL=
CASSA_PHARAOH_WALLET=0xE1f5A90854CFC43B936F7be135a84dFEf1A5ab50
ROG_DAO_ADDRESS=
ROG_URANUS_WALLET=
SOLVENCY_GUARD=
